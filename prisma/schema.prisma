generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model ReforgerSession {
  id String @id @default(cuid())

  serverId  String
  sessionId String

  missionId   String
  missionName String?

  startedAt DateTime?
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  objectives ReforgerObjective[]
  events     ReforgerEvent[]

  @@unique([serverId, sessionId])
  @@index([sessionId])
}

model ReforgerObjective {
  id String @id @default(cuid())

  sessionDbId String
  session     ReforgerSession @relation(fields: [sessionDbId], references: [id], onDelete: Cascade)

  taskId      String
  parentTaskId String?
  title       String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events ReforgerEvent[]

  @@unique([sessionDbId, taskId])
  @@index([taskId])
  @@index([sessionDbId, parentTaskId])
}

model ReforgerEvent {
  id      String @id @default(cuid())
  eventId String @unique

  sessionDbId String
  session     ReforgerSession @relation(fields: [sessionDbId], references: [id], onDelete: Cascade)

  type          String
  taskId        String?
  objectiveDbId String?
  objective     ReforgerObjective? @relation(fields: [objectiveDbId], references: [id], onDelete: SetNull)

  oldState     Int?
  oldStateName String?

  newState     Int?
  newStateName String?

  oldProgress Float?
  newProgress Float?

  eventTimestamp DateTime
  rawJson        Json

  createdAt DateTime @default(now())

  @@index([objectiveDbId])
}
