import { prisma } from "../lib/prisma.js";

export async function getReforgerSessionById(serverId: string, sessionId: string) {
    return prisma.reforgerSession.findUnique({
        where: {
            serverId_sessionId: {
                serverId,
                sessionId,
            },
        },
        include: {
            objectives: {
                orderBy: {
                    taskId: "asc",
                },
            },
            events: {
                orderBy: {
                    eventTimestamp: "asc",
                },
            },
        },
    });
}
